{
  "name": "verb-tack",
  "version": "1.0.0",
  "description": "Figma-style comments on live prototypes. One script tag, one Netlify Function, comments stored in Netlify Blobs.",
  "type": "module",
  "license": "MIT",
  "author": "Verb Interactive",
  "repository": {
    "type": "git",
    "url": "https://github.com/VERB-Design/VERB-Tack.git"
  },
  "exports": {
    "./function": "./netlify/functions/tack.mjs",
    "./embed": "./public/tack.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "verb-tack": "./bin/verb-tack.mjs"
  },
  "files": [
    "netlify/functions/tack.mjs",
    "public/tack.js",
    "bin",
    "templates",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npx netlify-cli dev",
    "dev:mock": "node --import ./test/register.mjs test/dev-server.mjs",
    "test": "node --import ./test/register.mjs --test test/tack.test.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^11.0.0"
  }
}
